# 复制为 .env 后按需修改：cp .env.example .env
# .env 仅用于本地开发，已被 .gitignore 忽略，不要提交到仓库

# 本地 MySQL 连接串（手工执行 migrations/*.sql 时参考）
# 应用运行时的数据库配置来自 etc/config.toml 的 [mysql] 段
DATABASE_URL=mysql://root:123456@localhost:3306/axum_best

# JWT 签名密钥：覆盖 etc/config.toml 的 [jwt].secret
# 生产环境必须通过环境变量注入，不要把真实密钥写进配置文件
JWT_SECRET=replace-this-secret

# 令牌有效期（秒）：覆盖 [jwt].expiration_secs，缺省为 3600
JWT_EXPIRATION_SECS=3600
