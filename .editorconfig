root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.rs]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.{json,sql}]
indent_size = 4

[*.toml]
indent_size = 4

[{Dockerfile,Dockerfile.*}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[{Makefile,makefile,*.mk}]
indent_style = tab

[*.sh]
indent_size = 2
